{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "mouse_follows_focus": true,
  "default_workspace_padding": 4,
  "default_container_padding": 4,
  "border": true,
  "border_width": 6,
  "border_offset": -1,
  "theme": {
    "palette": "Base16",
    "name": "PrimerDark",
    "unfocused_border": "Base00",
    "bar_accent": "Base09",
    "monocle_border": "Base0D",
    "single_border": "Base0F"
  },
  "display_index_preferences": {
    "0": "HCS0238-5&2524e507&0&UID264",
    "1": "HGC2380-5&2524e507&0&UID268",
    "2": "MSI4BA9-4&3623efdd&0&UID206371",
    "3": "ACI23C4-4&3623efdd&0&UID214571"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP"
        },
        {
          "name": "II",
          "layout": "Columns"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "Rows",
          "layout_options": {
            "row_ratios": [0.4]
          },
           "layout_flip": "Vertical"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "Codespace",
          "layout": "BSP"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "Grid",
          "layout_rules": {
            "1": "BSP",
            "4": "Grid"
          },
          "layout_options": {
            "column_ratios": [0.6]
          }
        }
      ]
    }
  ],
  "floating_applications": [
    {
      "kind": "Title",
      "id": "Discord",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Sticky Notes",
      "matching_strategy": "Contains"
    },
    {
      "kind": "Title",
      "id": "Riot Client",
      "matching_strategy": "Contains"
    },
    {
      "kind": "Title",
      "id": "Prism Launcher",
      "matching_strategy": "StartsWith"
    }
  ]
}
